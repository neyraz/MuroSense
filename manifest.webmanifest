{
  "id": "./",
  "name": "MuroSense",
  "short_name": "MuroSense",
  "description": "Peptidoglycan muropeptide LC-MS analysis: identification with a controlled false discovery rate, MS/MS and UV evidence, profile metrics and comparisons.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f1",
  "theme_color": "#ffffff",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-murosense": [".murosense"] },
      "icons": [
        { "src": "icons/session-file-256.png", "sizes": "256x256", "type": "image/png" },
        { "src": "icons/session-file-48.png", "sizes": "48x48", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" }
}
